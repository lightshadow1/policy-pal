# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ── Required ────────────────────────────────────────────────────────────────────
# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Model comparison (optional) ──────────────────────────────────────────────────
# Sonnet model ID used by compare_models.py — update to latest available version
SONNET_MODEL=claude-sonnet-4-5-20250929

# ── LLM reliability (optional — shown with defaults) ─────────────────────────────
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_REQUEST_TIMEOUT=30.0

# ── Guardrail thresholds (optional — shown with defaults) ────────────────────────
# Grounding: fraction of answer words that must appear in source doc (0.0–1.0)
GUARDRAIL_GROUNDING_THRESHOLD=0.25
# Relevance: fraction of question words that must appear in answer (0.0–1.0)
GUARDRAIL_RELEVANCE_THRESHOLD=0.15
# Max characters allowed in a single question
MAX_QUESTION_CHARS=2000

# ── Pricing overrides (optional — update when Anthropic changes rates) ───────────
# Used by calculate_cost(); values are USD per million tokens
# Default Haiku: input=$0.80, output=$4.00
# Default Sonnet: input=$3.00, output=$15.00
# (pricing is detected automatically by model name substring)
# CLAUDE_INPUT_PRICE_PER_MTK=0.80
# CLAUDE_OUTPUT_PRICE_PER_MTK=4.00

# ── Tracing (optional — off unless set) ────────────────────────────────────────
# Both exporters are independent; set either, both, or neither.
# Local OTLP/JSON lines. This is what `agentaudit report` consumes.
# POLICY_PAL_TRACE_FILE=traces.jsonl
# OTLP/HTTP collector, e.g. an OTel Collector or Grafana Tempo/Alloy endpoint.
# "/v1/traces" is appended if not already present.
# POLICY_PAL_OTLP_ENDPOINT=http://your-collector-host:4318
# Tags spans with deployment.environment.name
# POLICY_PAL_ENVIRONMENT=production
# Record prompt/completion text on spans. Opt-In in the GenAI conventions
# because message content is likely to carry PII. Inputs are already
# PII-scrubbed upstream; model replies are scrubbed before recording.
# POLICY_PAL_CAPTURE_CONTENT=1
# POLICY_PAL_CONTENT_MAX_CHARS=1800
# Where captured content goes: event (default) | span | both.
# "event" follows the GenAI conventions and lands in Loki (256KB lines, rejects
# oversize) rather than Tempo span attributes (2048B, truncates mid-string).
# POLICY_PAL_CONTENT_DESTINATION=event
# Local OTLP/JSON event log. Defaults to <trace file>.events.<ext> when unset.
# POLICY_PAL_EVENT_FILE=traces.events.jsonl
# POLICY_PAL_EVENT_CONTENT_MAX_CHARS=60000
